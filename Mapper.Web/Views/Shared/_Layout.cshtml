<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mapper</title>

    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-slate-100 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between px-8 py-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="text-2xl font-bold text-indigo-600">
                Mapper
            </a>

            <nav class="flex items-center gap-8">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-slate-700 hover:text-indigo-600 font-medium transition">
                    Home
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-slate-700 hover:text-indigo-600 font-medium transition">
                    Privacidade
                </a>

            </nav>

        </div>
    </header>

    <!-- Conteúdo -->
    <main class="flex-1">

        <div class="max-w-7xl mx-auto px-8 py-10">

            <div class="bg-white rounded-2xl shadow-md p-8">

                @RenderBody()

            </div>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200">

        <div class="max-w-7xl mx-auto px-8 py-6 flex justify-between">

            <span class="text-slate-500">
                © 2026 Mapper
            </span>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-indigo-600 hover:underline">
                Política de Privacidade
            </a>

        </div>

    </footer>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>